# =============================================================
# Risk Assessment Service 환경변수 예시
# -------------------------------------------------------------
# ※ 이 파일은 형식 안내용 예시입니다. 커밋 가능합니다.
# ※ 실제 값이 담긴 .env 파일은 절대 커밋하지 마세요. (.gitignore 등록됨)
# ※ 사용법: 이 파일을 복사 후 .env 로 저장하고 값을 채워주세요.
#     cp .env.example .env   (macOS/Linux)
#     copy .env.example .env (Windows CMD)
# =============================================================


# ─── 데이터베이스 ───────────────────────────────────────────
# ※ DB_PASSWORD: 공백/특수문자 포함 시 따옴표 없이 그대로 입력
# ※ DB_USER: DB에 최소 권한(SELECT/INSERT/UPDATE)만 부여된 전용 계정 사용 권장
DB_HOST=<DB서버_IP_또는_호스트명>    # 예) 192.168.x.x
DB_PORT=5432
DB_NAME=<데이터베이스명>
DB_USER=<DB계정명>
DB_PASSWORD=<DB비밀번호>             # ※ 절대 커밋 금지


# ─── LLM (LM Studio) ────────────────────────────────────────
# ※ LLM_BASE_URL: LM Studio가 실행 중인 서버 주소
# ※ LLM_TEMPERATURE: 0.0(일관성) ~ 1.0(창의성), 위험성 평가는 0.2~0.4 권장
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=<모델명>                   # 예) gemma-4
LLM_TEMPERATURE=0.3


# ─── API 서버 ────────────────────────────────────────────────
# ※ API_SERVER_HOST: 0.0.0.0 권장 (모든 인터페이스 수신)
#   - 0.0.0.0       → 외부 접근 허용 (운영)
#   - 127.0.0.1     → 로컬 전용 (테스트)
# ※ API_SERVER_PORT: 방화벽에서 해당 포트 오픈 필요
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8443


# ─── 관리자 인증 ─────────────────────────────────────────────
# ※ 32자 이상의 무작위 문자열 사용 강력 권장
# ※ 생성 방법:
#     python -c "import secrets; print(secrets.token_hex(32))"
#     openssl rand -hex 32
# ※ 절대 커밋 금지 / 주기적 교체 권장
ADMIN_SECRET_KEY=<32자_이상_무작위_문자열>    # ※ 절대 커밋 금지


# ─── Rate Limit ──────────────────────────────────────────────
# ※ API Key 당 분당 허용 요청 수
RATE_LIMIT_PER_MINUTE=30


# ─── 로깅 ────────────────────────────────────────────────────
# ※ LOG_LEVEL: DEBUG / INFO / WARNING / ERROR / OFF
#   - 운영 환경: INFO 권장
#   - 장애 추적 시: DEBUG 로 변경 후 서버 재시작 (소스 재배포 불필요)
# ※ LOG_DIR 경로 예시:
#   - 상대경로: logs                (서버 실행 위치 기준)
#   - Windows : D:/logs/risk        (포워드 슬래시 사용)
#   - Linux   : /var/log/risk
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_DIR=logs
